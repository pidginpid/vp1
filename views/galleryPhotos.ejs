				<div class="modalvertical">
					<p id="modalCaption"></p>
					<img id="modalImage" src="../pic/empty.png" alt="galeriipilt">
				</div>
			</div>
		<div id="gallery" class="gallery">
		<% pictureList.forEach(function(picture){ %>
		<li><img class="thumbs" data-id="<%=picture.id%>" src='/gallery/normal/<%= picture.filename %>' data-filename="<%=picture.src%>>" '/gallery/normal/<%= picture.filename %>' alt='<%= picture.alttext %>'><br><%= picture.alttext%></li>
		<% }); %>
	</div>
</body>
</html>
