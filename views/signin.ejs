<html lang="et">
<head>
	<meta charset="utf-8">
	<title>Karl Jakob Proso, veebiprogrammeerimine</title>
</head>
<body>
	<img src="pic/veebiprogrammeerimine_2026_TA.png" alt ="banner">	<h1>Karl Jakob Proso, veebiprogrammeerimine</h1>
	<h1>Sign up</h1>
	<p>Siin lehel saab teha endale konto</p>
	<hr>
	<form method="POST">
		<label for="emailInput">E-mail (kasutajatunnuseks)</label>
		<input type="email" id="emailInput" name="emailInput" placeholder="Sinu e-mail ...." required>
		<br>
		<label for="passwordInput">Salasõna (min 8 märki)</label>
		<input type="password" id="passwordInput" name="passwordInput" required>
		<br>
		<input type="submit" id="userSubmit" name="userSubmit" value="Logi sisse">
	</form>
	<p> <%= notice %></p>
</body>
</html>