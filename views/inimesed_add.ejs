<html lang="et">
<head>
	<meta charset="utf-8">
	<title>Karl Jakob Proso, veebiprogrammeerimine</title>
</head>
<body>
	<img src="/pic/veebiprogrammeerimine_2026_TA.png" alt ="banner">	<h1>Karl Jakob Proso, veebiprogrammeerimine</h1>
	<h1>Filmiga seotud inimesed</h1>
	<p>Siin lehel saab andmebaasi lisada Eesti filmi inimesi.</p>
	<hr>
	<ul>
		<li><a href="/">Avalehele</a></li>
		<li><a href="/eestifilm">Eesti filmi avaleht</a></li>
	</ul>
	<hr>
	<form method="POST">
		<label for="firstNameInput">Filmiinimese eesnimi</label>
		<input id="firstNameInput" name="firstNameInput" type="text" placeholder="Eesnimi ..." value="<%= firstName %>"
		required>
		<span><%= firstNameNotice %></span>
		<br>
		<label for="lastNameInput">Filmiinimese perekonnanimi</label>
		<input id="lastNameInput" name="lastNameInput" type="text" placeholder="Perekonnanimi ..." value="<%= lastName %>"
		required>
		<span><%= lastNameNotice %></span>
		<br>
		<label for="bornInput">Filmiinimese sünnikuupäev</label>
		<input id="bornInput" name="bornInput" type="date" value="<%= born %>"
		required>
		<span><%= bornNotice %></span>
		<br>
		<label for="deceasedInput">Surmakuupäev</label>
		<input id="deceasedInput" name="deceasedInput" type="date" value="<%= deceased %>">
		<span><%= deceasedNotice %></span>
		<br>
		<input id="personSubmit" name="personSubmit" type="submit" value="Salvesta">
	</form>
	<p><%= notice %></p>
</body>
</html>
